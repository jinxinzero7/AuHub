# AuHub local Docker Compose settings.
# Copy to `.env` for local development and replace every `change-me-*` value.
# Never commit real secrets.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-development-password

# JWT shared by Gateway-facing backend APIs.
# Use a long random value, at least 32 characters.
JWT_SECRET=change-me-long-random-jwt-secret-at-least-32-characters

# Service-to-service key for protected internal endpoints.
# Use a random value, at least 32 characters.
INTERNAL_API_KEY=change-me-random-internal-api-key-at-least-32-characters

# RabbitMQ
RABBITMQ_USER=auhub
RABBITMQ_PASSWORD=change-me-rabbitmq-development-password

# Public URL of the API gateway (used to build image URLs returned to the frontend).
# Production: set to https://<your-domain-or-ip>
EXTERNAL_BASE_URL=http://localhost:5000

# MinIO
MINIO_ROOT_USER=auhub-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-development-password
# Public URL for presigned image URLs (must be accessible from browser).
# Production: set to http(s)://<your-server-ip-or-domain>:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000

# Optional admin bootstrap.
# Leave email/password empty to disable automatic admin creation.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=AuHub Admin
ADMIN_BOOTSTRAP_PHONE_NUMBER=+70000000000
ADMIN_BOOTSTRAP_NICKNAME=auhub_admin

# Robokassa demo checkout.
# Leave credentials empty to keep checkout unavailable while demo wallet top-up remains usable.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
ROBOKASSA_CULTURE=ru
ROBOKASSA_IS_TEST=true

# Email/SMS verification currently uses dev senders that log tokens/codes.
# Production adapters are intentionally not configured in the current MVP.
