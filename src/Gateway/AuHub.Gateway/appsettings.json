{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information",
        "Yarp.ReverseProxy.Forwarder": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithCorrelationId"]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeader": "X-Gateway-Forwarded", "Set": "AuHub-Gateway" }
        ]
      },
      "auctions-route": {
        "ClusterId": "auctions-cluster",
        "Match": {
          "Path": "/api/lots/{**catch-all}"
        },
        "RateLimiterPolicy": "auction-api-limiter",
        "CorsPolicy": "GatewayCorsPolicy",
        "Transforms": [
          { "RequestHeader": "X-Forwarded-Host", "Set": "localhost:5000" },
          { "RequestHeader": "X-Forwarded-Proto", "Set": "http" }
        ]
      },
      "signalr-route": {
        "ClusterId": "auctions-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        },
        "CorsPolicy": "GatewayCorsPolicy"
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "CorsPolicy": "GatewayCorsPolicy"
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        },
        "CorsPolicy": "GatewayCorsPolicy"
      },
      "admin-users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/admin/users/{**catch-all}"
        },
        "CorsPolicy": "GatewayCorsPolicy",
        "Transforms": [
          { "PathPattern": "/api/auth/users/{**catch-all}" }
        ]
      },
      "admin-route": {
        "ClusterId": "auctions-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        },
        "CorsPolicy": "GatewayCorsPolicy"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "identity-api-1": {
            "Address": "http://identity-api:8080"
          }
        }
      },
      "auctions-cluster": {
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": "AuHub.AuctionSession",
          "FailurePolicy": "Redistribute",
          "Settings": {
            "Cookie.Name": "AuHub.AuctionSession"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "auctions-api-1": {
            "Address": "http://auctions-api:8080"
          }
        }
      },
      "notifications-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "notifications-api-1": {
            "Address": "http://notifications-api:8080"
          }
        }
      },
      "payment-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "payment-api-1": {
            "Address": "http://payment-api:8080"
          }
        }
      }
    }
  }
}
